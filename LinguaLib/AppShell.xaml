<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:LinguaLib.Views"
       x:Class="LinguaLib.AppShell"
       Shell.NavBarHasShadow="True">

    <Shell.Resources>
        <Style TargetType="Shell" ApplyToDerivedTypes="True">
            <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light=#7C6AF7, Dark=#2A1F6E}"/>
            <Setter Property="Shell.ForegroundColor" Value="White"/>
            <Setter Property="Shell.TitleColor" Value="White"/>
            <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1E1E2E}"/>
            <Setter Property="Shell.TabBarForegroundColor" Value="#7C6AF7"/>
            <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light=#AAA, Dark=#555}"/>
        </Style>
    </Shell.Resources>

    <TabBar>
        <ShellContent Title="Library" Route="LibraryPage"
                      ContentTemplate="{DataTemplate views:LibraryPage}"/>
        
        <ShellContent Title="📖" Route="DictionaryPage"
                      ContentTemplate="{DataTemplate views:DictionaryPage}"/>
        <ShellContent Title="💡" Route="StudyPage"
                      ContentTemplate="{DataTemplate views:StudyPage}"/>
        <ShellContent Title="⚙️" Route="SettingsPage"
                      ContentTemplate="{DataTemplate views:SettingsPage}"/>
    </TabBar>
</Shell>
