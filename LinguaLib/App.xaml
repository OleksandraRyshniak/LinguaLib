<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LinguaLib"
             xmlns:conv="clr-namespace:LinguaLib.Converters"
             x:Class="LinguaLib.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:InvertBoolConverter x:Key="InvertBoolConverter"/>
            <conv:IntToDoubleConverter x:Key="IntToDoubleConverter"/>
            <conv:StringToBoolConverter x:Key="StringToBoolConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
